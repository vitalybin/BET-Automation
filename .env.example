# Puralox-XDI standalone deployment
UPLOAD_FOLDER=/usr/src/app/uploads
DB_NAME=/usr/src/app/data/Purlox.db

# External eLabFTW API
# API key name in eLabFTW can be "XdiExtractor"; paste the actual generated token below.
ELABFTW_URL=https://dtpa-akg.de/api/v2
ELABFTW_TOKEN=

# Keep SSL verification enabled for https://dtpa-akg.de/
ELABFTW_DISABLE_SSL=false
